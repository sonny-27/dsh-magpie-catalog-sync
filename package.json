{
  "name": "dsh-magpie-catalog-sync",
  "version": "0.4.9",
  "description": "Automatically import Magpie model capabilities, reasoning efforts and advertised service tiers into DSH and DS Bot.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "client.mjs",
    "lib",
    "server/search-policy.py",
    "server/gemini-video/bridge.py",
    "server/gemini-video/manage.py",
    "server/gemini-video/browser_session.py",
    "server/gemini-video/proxy.py",
    "server/gemini-video/login_portal.py",
    "server/gemini-video/account_pool.py",
    "server/gemini-video/multi_login_portal.py",
    "server/gemini-video/provision_accounts.py",
    "server/gemini-video/Dockerfile",
    "server/gemini-video/compose.yaml",
    "server/gemini-video/README.md",
    "scripts/install-local.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": "^0.1.5-rc.2 || ^0.2.1-rc.5 || ^0.2.2-rc.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sonny-27/dsh-magpie-catalog-sync.git"
  }
}
